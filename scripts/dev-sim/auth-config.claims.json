{
  "providers": [
    {
      "type": "oidc",
      "id": "oidc",
      "label": "Simuleret kommune-login (OIDC)",
      "clientId": "${SIM_OIDC_CLIENT_ID}",
      "clientSecret": "${SIM_OIDC_CLIENT_SECRET}",
      "discoveryUrl": "${SIM_OIDC_DISCOVERY_URL}",
      "scopes": ["openid", "profile", "email"],
      "pkce": true,
      "claims": { "email": "email", "name": "name" },
      "rolesClaim": "roles",
      "groupsClaim": { "name": "memberOf", "format": "delimited", "separator": ";" }
    },
    {
      "type": "saml",
      "id": "saml",
      "label": "Simuleret kommune-login (SAML)",
      "idpMetadataFile": "${SIM_SAML_METADATA_FILE}",
      "claims": { "userId": "uid", "email": "mail", "name": "displayName" },
      "rolesClaim": "roles",
      "groupsClaim": { "name": "memberOf", "format": "delimited", "separator": ";" }
    }
  ],
  "roles": {
    "byProvider": {
      "oidc": {
        "appRoleMap": {
          "referat-admin": "admin",
          "referat-superuser": "bygger",
          "referat-bruger": "bruger"
        },
        "groupRoleMap": {}
      },
      "saml": {
        "appRoleMap": {
          "referat-admin": "admin",
          "referat-superuser": "bygger",
          "referat-bruger": "bruger"
        },
        "groupRoleMap": {}
      }
    }
  },
  "catalogue": [
    { "kind": "role", "identifier": "referat-admin", "name": "Referat: administrator" },
    { "kind": "role", "identifier": "referat-superuser", "name": "Referat: bygger (superbruger)" },
    { "kind": "role", "identifier": "referat-bruger", "name": "Referat: bruger" },
    { "kind": "group", "identifier": "G-Borgerservice", "name": "Borgerservice" },
    { "kind": "group", "identifier": "G-Okonomi", "name": "Økonomi" }
  ]
}
