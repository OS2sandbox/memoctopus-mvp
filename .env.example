DATABASE_URL=postgres://postgres:postgres@localhost:5432/referat
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Must match the public URL of the app — used by better-auth for OAuth callbacks.
# Changing this requires redeploying the server (not just the frontend).
BETTER_AUTH_URL=http://localhost:3004
# Comma-separated extra trusted origins (localhost:3004 is always included)
BETTER_AUTH_TRUSTED_ORIGINS=
OPENAI_API_KEY=
# Chat LLM backend for minutes / PII / chapters / clarifications:
#   - OPENAI_API_KEY set  → hosted OpenAI (gpt-4o)
#   - no key              → self-hosted vLLM (Qwen) at http://vllm-chat:8000/v1
# Override the endpoint/model explicitly for any OpenAI-compatible server:
#   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_MODEL=
AUDIO_STORAGE_PATH=./audio-storage

# ── Auth ─────────────────────────────────────────────────────────────────────
# All auth settings are read at runtime, so changing them needs only a restart
# (`docker compose up -d app`) — no image rebuild.
#
# MUNICIPAL / MULTI-IDP SETUP (recommended): describe the identity providers (any number
# of OIDC, Microsoft Entra ID and SAML 2.0) and, for ACCESS_SOURCE=claims, the mapping from
# IdP role claims to app roles in ONE JSON file, in the directory mounted at /config
# (AUTH_CONFIG_DIR, default ./auth-config). Setting AUTH_CONFIG_FILE makes that file the ONLY
# source of providers: the MICROSOFT_* / OIDC_* / AUTHENTIK_* variables below are then ignored.
# `${NAME}` inside the file is replaced from the environment, so secrets can stay out of it.
# Read once at start. Format, recipes (FKA, OS2faktor, Authentik, Entra) and SAML URLs:
# docs/central-access/idp.md.
#AUTH_CONFIG_DIR=./auth-config
#AUTH_CONFIG_FILE=/config/auth.json
#
# Without a file, Microsoft and OIDC enable themselves as soon as their credentials are filled
# in. The *_ENABLED flags below are kill switches, not opt-ins: leave them blank
# for the default, or set "false" to force a method off while keeping its
# credentials in place.
# Blank = on, except with ACCESS_SOURCE=claims, where password sign-in is OFF unless this is
# explicitly "true" (and sign-up stays closed there either way: a password account holds no
# role). Municipal installations with their own IdP: leave it blank or set "false".
EMAIL_PASSWORD_ENABLED=
MICROSOFT_ENABLED=
OIDC_ENABLED=

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Leave blank to allow any Microsoft account (personal + work/school)
MICROSOFT_TENANT_ID=

# Generic OIDC — Keycloak, Authentik, or any standards-compliant IdP.
# Setup, discovery URL patterns per IdP, the redirect URI to register, and the
# account-linking caveat: see DEPLOY.md → "Single sign-on (OIDC)".
#
# ⚠️  OIDC_PROVIDER_ID is part of the callback URL *and* the key that ties users
#     to their accounts. Changing it after go-live means returning users no longer
#     match their existing account and get a brand-new (empty) one. Pick it once.
# Leave both commented out to take the defaults ("oidc"/"SSO", or "authentik"/
# "Authentik" when upgrading from the AUTHENTIK_* variables below). Setting
# OIDC_PROVIDER_ID explicitly overrides that fallback.
#OIDC_PROVIDER_ID=keycloak
# Button label only: "Fortsæt med <name>".
#OIDC_PROVIDER_NAME=Kommune Login
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
# PKCE is on by default. Set "false" only if your IdP rejects the extra params.
OIDC_PKCE=

# Deprecated aliases, still read so existing deployments keep working:
#   NEXT_PUBLIC_EMAIL_PASSWORD_ENABLED → EMAIL_PASSWORD_ENABLED
#   NEXT_PUBLIC_MICROSOFT_ENABLED      → MICROSOFT_ENABLED
#   NEXT_PUBLIC_AUTHENTIK_ENABLED      → OIDC_ENABLED
#   AUTHENTIK_CLIENT_ID/_SECRET/_DISCOVERY_URL → the OIDC_* equivalents
# The AUTHENTIK_* trio applies only when OIDC_* is incomplete; migration steps
# are in DEPLOY.md.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_DISCOVERY_URL=

# ── Central access control ───────────────────────────────────────────────────
# Roles and org units. Read at runtime: change and restart, no rebuild.
# local:        an administrator assigns roles in the app (/admin).
# rollekatalog: roles come from OS2rollekatalog; the local admin writes answer 409.
# claims:       roles come from the role/group claims the IdP sends at login (OIDC claim or
#               SAML attribute), mapped by the "roles" section of AUTH_CONFIG_FILE. The rights
#               are managed OUTSIDE this app (in the IdP, or upstream of it, e.g. OS2rollekatalog);
#               the app has no role admin. Needs AUTH_CONFIG_FILE, an Entra tenant that is ONE tenant
#               id (never common), and ordinary users mapped to tt-bruger. See docs/central-access/idp.md.
# Anything else (a typo such as "rolekatalog") is NOT treated as local: access control
# answers 503 "Adgangskontrol er midlertidigt utilgængelig" until it is fixed.
ACCESS_SOURCE=local
# Kill switch for the in-app role administration (grant/revoke, local org units and members,
# the first-administrator bootstrap). Local mode only: in rollekatalog and claims mode it is
# always off, whatever this says. Blank = on in local mode. "false" turns it off (writes then
# answer 409 and the pages become read-only). Municipal installations run claims or rollekatalog;
# local mode is for development, demos and the dev simulation.
ACCESS_LOCAL_ADMIN=
# Claims mode: how many seconds the roles of a login count (default 28800 = 8 h; 60 .. 2592000).
# Claims only change at login, so this is also how long a role that was removed upstream can
# linger. The SESSION lasts exactly as long, so nobody is signed in on a stale snapshot.
ROLE_CLAIMS_MAX_SECONDS=
# "true": a user with no role assignment gets "Ingen adgang" instead of the app
# pages, and the /api routes answer 403 (disabled users always do). Blank = false in local and
# rollekatalog mode, so every signed-in user keeps the baseline role tt-bruger and nothing
# changes on upgrade. With ACCESS_SOURCE=claims blank means TRUE: ordinary users must be
# mapped to tt-bruger (appRoleMap / groupRoleMap in the auth config file), otherwise nobody who
# the IdP does not map gets in. Only an explicit "false" opens claims mode to everyone who can
# sign in at the IdP (a start-up warning says so). Leave it blank in docker compose.
REQUIRE_ROLE_TO_LOGIN=
# Comma-separated, case-insensitive. Local mode only, ONE-SHOT: grants tt-administrator
# to the first SSO login with one of these addresses while no administrator exists, and
# then never again (flag 'bootstrap_admin_done' in public.system_flags). Email/password
# sign-ups never qualify. Microsoft also needs a single-tenant MICROSOFT_TENANT_ID;
# generic OIDC needs email_verified=true from the IdP. Recovery after a lock-out:
#   DELETE FROM system_flags WHERE key = 'bootstrap_admin_done';
BOOTSTRAP_ADMIN_EMAILS=
# Rollekatalog mode only: how a login is linked to a directory user.
#   userid-claim (default) | extuuid-claim | email (needs email_verified=true)
DIRECTORY_MATCH=userid-claim
# ID-token claim that carries the Rollekatalog user id (userid-claim/extuuid-claim).
DIRECTORY_USERID_CLAIM=preferred_username
# Headers better-auth and the audit log read the client IP from, e.g. "x-real-ip,x-forwarded-for".
# Blank keeps the default (x-forwarded-for). Read once at startup. The shipped nginx
# overwrites X-Forwarded-For and X-Real-IP with $remote_addr; any other proxy in front
# must overwrite them too, otherwise the stored IP can be forged.
AUTH_IP_HEADERS=

# ── Rollekatalog (OS2rollekatalog) ───────────────────────────────────────────
# Used for the user and organisation sync when ACCESS_SOURCE=rollekatalog, and (any mode,
# URL and READ key only) for the optional ROLE CATALOGUE that shared prompts are targeted
# at (a cron calling POST /api/internal/rollekatalog/roles, or the admin button).
# Rollekatalog is READ-ONLY for this app: it only sends GET requests. Read at runtime: change and restart, no rebuild.
# Operator guide: docs/central-access/rollekatalog.md. The sync is scheduled outside
# the app: a cron calling POST /api/internal/rollekatalog/sync (DEPLOY.md).
# Base URL of Rollekatalog. Must be https:// (plain http only for localhost, or when
# ROLLEKATALOG_ALLOW_HTTP=true). Blank = integration not configured.
ROLLEKATALOG_URL=
# API key of a Rollekatalog API client with client role READ_ACCESS (role
# assignments). Never log or commit it.
ROLLEKATALOG_READ_API_KEY=
# API key of a SECOND API client with client role ORGANISATION (users, org units).
# It does not imply READ_ACCESS, so both keys are needed for a sync.
ROLLEKATALOG_ORG_API_KEY=
# Identifier of the IT system (created by hand in Rollekatalog) the roles live under.
ROLLEKATALOG_ITSYSTEM_ID=os2taletiltekst
# Rollekatalog domain; blank = its primary domain.
ROLLEKATALOG_DOMAIN=
# Per request attempt, response body included, in ms (1000 to 300000; a larger value is rejected and the default used). Blank = 120000 (2 min).
# The calls are bulk downloads (organisation v3 can be tens of MB); a timeout is never retried.
ROLLEKATALOG_TIMEOUT_MS=120000
# Largest accepted response in bytes. Blank = 67108864 (64 MiB).
ROLLEKATALOG_MAX_RESPONSE_BYTES=
# "true" allows a plain http:// URL on a non-local host (API keys then travel in
# cleartext). Leave blank unless the traffic is on a trusted private network.
ROLLEKATALOG_ALLOW_HTTP=
# "true" (default): the org unit of an assignment's constraint also covers its
# sub-units; "false": that unit only.
ROLLEKATALOG_SCOPE_DESCENDANTS=true
# Roles that may become organisation-wide when an assignment carries no usable
# org-unit scope. Default tt-administrator only; every other role is then NOT granted.
# Comma list of tt-bruger, tt-skabelonansvarlig, tt-logleser, tt-administrator, or "none".
ROLLEKATALOG_GLOBAL_ROLES=tt-administrator
# A sync that would disable or delete more than this percent of the mirrored users
# (or role assignments) aborts; only the admin button can force it.
ROLLEKATALOG_SYNC_MAX_REMOVAL_PERCENT=30
# Where the role catalogue reads the user roles (jobfunktionsroller) and the role groups
# (rollebuketter). The defaults come from the OS2rollekatalog source and are NOT verified
# against a live instance; only a path under /api/read/ is accepted, "none" switches a list
# off. /api/read/userroles lists numeric ids only, the default also the string identifier.
# ROLLEKATALOG_ROLES_PATH=/api/read/userroles/itsystems
# ROLLEKATALOG_ROLEGROUPS_PATH=/api/read/rolegroups
# Rollekatalog-sourced roles not refreshed for this many seconds stop applying
# (elevated access vanishes; the baseline tt-bruger stays). Default 86400 = 24 h.
ROLE_STALE_MAX_SECONDS=86400
# none (default) | strip-upn-domain: strip "@domain" from the login claim before it
# is matched against the Rollekatalog userId (UPN "abc123@kommune.dk" -> "abc123").
# strip-upn-domain only accepts a claim of the exact form <name>@<DIRECTORY_USERID_DOMAIN>
# (one "@", domain compared case-insensitively, no "#EXT#" guest marker); anything else,
# for instance a guest "abc123@other.example", is no match. It matches nothing at all
# while DIRECTORY_USERID_DOMAIN is blank, so set both together.
# Microsoft logins link in Rollekatalog mode only with a single-tenant
# MICROSOFT_TENANT_ID (not common/organizations/consumers) and a matching tid.
DIRECTORY_USERID_TRANSFORM=none
# Your UPN domain, for example kommune.dk (no "@"). Only used with strip-upn-domain.
DIRECTORY_USERID_DOMAIN=

# Skabelon sharing methods — choose which ways users can share templates.
# code: a self-contained copy/paste code (no server storage); on unless set to "false".
# link: a server-stored token + import link (needs the shared_skabeloner table,
#       created automatically on first use); opt-in, set to "true" to enable.
SKABELON_SHARE_CODE=true
SKABELON_SHARE_LINK=false

# Microsoft Teams bot service
BOT_SERVICE_URL=http://localhost:3001
BOT_INTERNAL_SECRET=change-me-to-a-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3004
# URL the bot-service uses to call back into the Next.js app (dev runs on 3004)
NEXT_APP_URL=http://localhost:3004

# Transcription — STT, OpenAI-compatible API (per-utterance live path + batch pass).
# Selection mirrors the LLM backend above:
#   - HVISKE_API_KEY set  → hosted syv.ai platform (syv-transcribe) + inline diarization
#   - no key              → self-hosted vLLM ASR (syvai/hviske-ensemble) at http://vllm-asr:8000/v1
# Override the endpoint/model explicitly for any OpenAI-compatible STT server:
#   HVISKE_URL=https://platform.syv.ai/v1   HVISKE_MODEL=syv-transcribe
HVISKE_URL=
HVISKE_MODEL=
HVISKE_API_KEY=
ASR_LANGUAGE=da
# HVISKE_DIARIZE: inline diarization (one call returns text + speaker + timestamps).
# Auto-ON for platform.syv.ai, auto-OFF for the self-hosted hviske (which transcribes
# only and diarizes via the separate /diarize service below). Set true|false to override.
HVISKE_DIARIZE=true

# Speaker diarization — runs a single acoustic pass over the full recording to label
# "who spoke when"; the result is merged onto the hviske transcript by time-overlap.
# It is now co-hosted ON the hviske server at POST /diarize (same host:port as
# transcription). Leave DIARIZATION_URL empty to derive it from HVISKE_URL (minus the
# /v1 suffix); set it explicitly only for a split deployment (e.g. the standalone
# diarization-service/ container, which still serves /diarize too).
DIARIZATION_URL=
DIARIZATION_API_KEY=
# Optional: only for a SPLIT deployment where diarization runs on a separate box
# reachable over SSH. With the co-hosted endpoint above no tunnel is needed.
#   DIARIZATION_SSH=-p 22 user@gpu-host
#   DIARIZATION_TUNNEL=5000:localhost:5000
DIARIZATION_SSH=
DIARIZATION_TUNNEL=5000:localhost:5000

# ── Audit log ────────────────────────────────────────────────────────────────
# Activity metadata only (who did what, when, to which id), never content. Read at
# runtime: change and restart, no rebuild. Details: docs/central-access/audit.md.
# "true": also print every event as one JSON line on stdout (for a log shipper).
AUDIT_STDOUT=false
# "false": store no IP address in the log (user agent and request id are kept).
AUDIT_STORE_IP=true
# Delete events older than this many days. Blank or invalid = 365 (the default).
# To keep the log forever, set it explicitly to 0, off, false, never or forever.
# Pruning only runs when something calls POST /api/internal/audit/prune (see below).
AUDIT_RETENTION_DAYS=
# Most client-reported (meeting.*) events stored per user per 24 h. Blank, 0 or
# invalid = 20000 (a runaway-client guard; views, edits and recording steps are all
# reported). Refused events are counted in the response and warned about in the log.
AUDIT_CLIENT_EVENTS_DAILY_CAP=
# SIEM feed (GET /api/audit/feed). Hex sha256 of the service key; blank turns the
# feed off. Compute: printf '%s' 'YOUR-KEY' | openssl dgst -sha256 -r | cut -d' ' -f1
# The key itself goes to the SIEM in the X-Audit-Key header and is never stored here.
AUDIT_FEED_API_KEY_HASH=
# The feed only returns rows older than this many seconds (default 10).
AUDIT_FEED_DELAY_SECONDS=10
# Shared secret (header X-Cron-Secret) for POST /api/internal/audit/prune and
# POST /api/internal/rollekatalog/sync. Blank makes both routes answer 404.
# openssl rand -hex 24
INTERNAL_CRON_SECRET=
