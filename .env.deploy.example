# ─────────────────────────────────────────────────────────────────────────────
# Deployment env for docker compose. Copy to `.env` on the server:
#     cp .env.deploy.example .env   &&   edit values
#
# The SAME file drives both deploy modes — only the AI section differs:
#   • "small"      (base only):   docker compose up -d
#   • "everything" (+ AI overlay): docker compose -f docker-compose.yml -f docker-compose.ai.yml up -d
# See DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Host port the frontend is published on (container always listens on 3000).
APP_PORT=8080
# Public URL users hit. For an SSH-tunnel test: http://localhost:8080
# For a real deployment: https://your-domain (must match how the browser reaches it).
BETTER_AUTH_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:8080
# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# Comma-separated extra trusted origins (optional)
BETTER_AUTH_TRUSTED_ORIGINS=

# ── Database (the in-compose Postgres) ───────────────────────────────────────
# Pin the Postgres image for reproducible deploys.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=referat
POSTGRES_DB=referat
# openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
# Must match the three values above (host is the compose service name `db`).
DATABASE_URL=postgres://referat:CHANGE_ME@db:5432/referat

# ── Chat LLM (minutes / PII / chapters / clarifications) ─────────────────────
# Hosted: set OPENAI_API_KEY → app uses OpenAI gpt-4o.
# Self-hosted (AI overlay): leave OPENAI_API_KEY blank → app uses the in-compose
# vllm-chat at http://vllm-chat:8000/v1. Then BOTH of these must be set and MATCH:
#   VLLM_MODEL = the model vllm-chat SERVES  (docker-compose.ai.yml command)
#   LLM_MODEL  = the model the app REQUESTS  (else llm-client defaults to Qwen → 404)
# google/gemma-4-12b-it is the verified self-hosted model (needs vLLM v0.24.0; see below).
OPENAI_API_KEY=
VLLM_MODEL=google/gemma-4-12b-it
LLM_MODEL=google/gemma-4-12b-it

# ── Bot service ──────────────────────────────────────────────────────────────
# openssl rand -hex 24 — shared secret between app and bot-service.
BOT_INTERNAL_SECRET=CHANGE_ME
BOT_MAX_SESSIONS=5

# ── hviske STT + diarization ─────────────────────────────────────────────────
# These bearer keys are the contract between the app (client) and the services.
# In "everything" mode they're ALSO consumed by the in-compose hviske/diarization,
# so the app and the services share the same value.
HVISKE_API_KEY=
DIARIZATION_API_KEY=
HVISKE_MODEL=syvai/hviske-ensemble
ASR_LANGUAGE=da
# diarization compute device: cuda (default) | cpu. Force cpu only if the GPU is
# saturated by hviske — diarization is 10-20x slower on CPU.
DIARIZATION_DEVICE=cuda

# ── AI endpoints — depends on deploy mode ────────────────────────────────────
# SMALL mode (AI hosted on another box): you MUST point these at that host —
# leaving them blank breaks transcription/diarization (the app gets an empty URL).
#   HVISKE_URL=http://OTHER-GPU-HOST:40093/v1
#   DIARIZATION_URL=http://OTHER-GPU-HOST:5000
# EVERYTHING mode ONLY: the AI overlay overrides both to the in-compose service
# names, so their value here is ignored — leaving them blank is fine in that mode.
HVISKE_URL=http://CHANGE-ME-GPU-HOST:40093/v1
DIARIZATION_URL=http://CHANGE-ME-GPU-HOST:5000

# ── Auto SSH tunnel for diarization (tunnel overlay) ─────────────────────────
# Small-mode convenience: if the GPU box's diarization is bound to its loopback
# (not publicly reachable), merge docker-compose.tunnel.yml and set the ssh target
# here. A sidecar opens the tunnel automatically and the overlay repoints the app
# at it (http://diar-tunnel:5000) — no manual `ssh -L`, no host port used.
#   docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d
DIARIZATION_SSH=-p 22 user@CHANGE-ME-GPU-HOST
# host:port to forward to, as seen from the ssh host (default localhost:5000)
DIAR_TUNNEL_REMOTE=localhost:5000
# ssh key dir mounted into the sidecar (default ~/.ssh). Passphrase keys need an agent.
SSH_DIR=

# ── AI overlay only (ignored in small mode) ──────────────────────────────────
# Hugging Face token — only needed if the model/weights repos are gated.
HF_TOKEN=
# GPU VRAM split: hviske (STT) and vllm-chat (chat LLM) share ONE card, so keep the
# sum of these two well under 1.0 (diarization also needs ~1-2 GB). The 0.25/0.50
# split below fits gemma-4-12b + hviske + diarization on a single large card.
HVISKE_GPU_MEM_UTIL=0.25
VLLM_CHAT_GPU_MEM_UTIL=0.50
# Host port to expose hviske on (optional external access).
HVISKE_PORT=40093
# vLLM image for the CHAT model (vllm-chat). gemma-4-12b needs v0.24.0 (v0.22.1's
# Gemma-4 impl is broken). NOTE: this does NOT apply to hviske — ASR runs a custom
# image (vllm/vllm-openai:v0.19.0 + librosa, built from vllm-asr/Dockerfile) because
# the stock image lacks librosa and v0.19.1+ regresses the ASR decoder.
VLLM_IMAGE_TAG=v0.24.0

# Model-weight caching (optional). Leave blank for the defaults:
#   • hviske: weights download once into a named volume (persist across restarts).
#   • diarization: weights baked into the image at build time.
# To REUSE pre-downloaded weights and avoid re-downloading on a new host:
#   HF_CACHE_DIR — host path with an HF cache; bind-mounted into hviske
#                  (e.g. /workspace/.hf_home). Leave blank to use the named volume.
HF_CACHE_DIR=
#   DIAR_HF_CACHE_DIR — host path with pre-downloaded pyannote weights; bind-mounted
#                       at /models. Leave blank to use a named volume that's seeded
#                       from the baked image (the default just works).
#   DIARIZATION_BAKE_WEIGHTS=false — skip the build-time download; pair with a
#                       populated DIAR_HF_CACHE_DIR so weights are present at runtime.
DIARIZATION_BAKE_WEIGHTS=true
DIAR_HF_CACHE_DIR=

# ── Login methods ────────────────────────────────────────────────────────────
# Read at runtime: change and `docker compose up -d app`, no rebuild needed.
# Microsoft and OIDC turn themselves on once credentials are filled in; the
# *_ENABLED flags are kill switches ("false" forces a method off).
EMAIL_PASSWORD_ENABLED=true
MICROSOFT_ENABLED=
OIDC_ENABLED=

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Generic OIDC (Keycloak, Authentik, …). See DEPLOY.md → "Single sign-on (OIDC)".
# Register this redirect URI in your IdP:
#   <BETTER_AUTH_URL>/api/auth/oauth2/callback/<OIDC_PROVIDER_ID>
# ⚠️  Do not change OIDC_PROVIDER_ID after go-live — it keys users to their accounts.
# Leave commented to take the default ("oidc", or "authentik" when the deprecated
# AUTHENTIK_* variables below are in use).
#OIDC_PROVIDER_ID=keycloak
#OIDC_PROVIDER_NAME=Kommune Login
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_PKCE=

# Deprecated, still honoured. Used only when the OIDC_* trio above is incomplete;
# the provider id then stays "authentik" so existing logins keep working.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_DISCOVERY_URL=

# ── Central access control ───────────────────────────────────────────────────
# Roles and org units. Read at runtime: change and `docker compose up -d app`,
# no rebuild needed.
# local:        an administrator assigns roles in the app (/admin).
# rollekatalog: roles come from OS2rollekatalog; the local admin writes answer 409.
# Anything else (a typo such as "rolekatalog") is NOT treated as local: access control
# answers 503 "Adgangskontrol er midlertidigt utilgængelig" until it is fixed.
ACCESS_SOURCE=local
# "true": a user with no role assignment gets "Ingen adgang" instead of the app
# pages, and the /api routes answer 403 (disabled users always do). Default is false,
# so every signed-in user keeps the baseline role tt-bruger and nothing changes on
# upgrade.
REQUIRE_ROLE_TO_LOGIN=false
# Comma-separated, case-insensitive. Local mode only, ONE-SHOT: grants tt-administrator
# to the first SSO login with one of these addresses while no administrator exists, and
# then never again (flag 'bootstrap_admin_done' in public.system_flags). Email/password
# sign-ups never qualify. Microsoft also needs a single-tenant MICROSOFT_TENANT_ID;
# generic OIDC needs email_verified=true from the IdP. Recovery after a lock-out:
#   DELETE FROM system_flags WHERE key = 'bootstrap_admin_done';
BOOTSTRAP_ADMIN_EMAILS=
# Rollekatalog mode only: how a login is linked to a directory user.
#   userid-claim (default) | extuuid-claim | email (needs email_verified=true)
DIRECTORY_MATCH=userid-claim
# ID-token claim that carries the Rollekatalog user id (userid-claim/extuuid-claim).
DIRECTORY_USERID_CLAIM=preferred_username
# Headers better-auth and the audit log read the client IP from, e.g. "x-real-ip,x-forwarded-for".
# Blank keeps the default (x-forwarded-for). Read once at startup. The shipped nginx
# overwrites X-Forwarded-For and X-Real-IP with $remote_addr; any other proxy in front
# must overwrite them too, otherwise the stored IP can be forged.
AUTH_IP_HEADERS=

# ── Rollekatalog (OS2rollekatalog) ───────────────────────────────────────────
# Only used when ACCESS_SOURCE=rollekatalog. Rollekatalog is READ-ONLY for this app:
# it only sends GET requests. Read at runtime: change and restart, no rebuild.
# Operator guide: docs/central-access/rollekatalog.md. The sync is scheduled outside
# the app: a cron calling POST /api/internal/rollekatalog/sync (DEPLOY.md).
# Base URL of Rollekatalog. Must be https:// (plain http only for localhost, or when
# ROLLEKATALOG_ALLOW_HTTP=true). Blank = integration not configured.
ROLLEKATALOG_URL=
# API key of a Rollekatalog API client with client role READ_ACCESS (role
# assignments). Never log or commit it.
ROLLEKATALOG_READ_API_KEY=
# API key of a SECOND API client with client role ORGANISATION (users, org units).
# It does not imply READ_ACCESS, so both keys are needed for a sync.
ROLLEKATALOG_ORG_API_KEY=
# Identifier of the IT system (created by hand in Rollekatalog) the roles live under.
ROLLEKATALOG_ITSYSTEM_ID=os2taletiltekst
# Rollekatalog domain; blank = its primary domain.
ROLLEKATALOG_DOMAIN=
# Per request attempt, response body included, in ms (1000 to 300000; a larger value is rejected and the default used). Blank = 120000 (2 min).
# The calls are bulk downloads (organisation v3 can be tens of MB); a timeout is never retried.
ROLLEKATALOG_TIMEOUT_MS=120000
# Largest accepted response in bytes. Blank = 67108864 (64 MiB).
ROLLEKATALOG_MAX_RESPONSE_BYTES=
# "true" allows a plain http:// URL on a non-local host (API keys then travel in
# cleartext). Leave blank unless the traffic is on a trusted private network.
ROLLEKATALOG_ALLOW_HTTP=
# "true" (default): the org unit of an assignment's constraint also covers its
# sub-units; "false": that unit only.
ROLLEKATALOG_SCOPE_DESCENDANTS=true
# Roles that may become organisation-wide when an assignment carries no usable
# org-unit scope. Default tt-administrator only; every other role is then NOT granted.
# Comma list of tt-bruger, tt-skabelonansvarlig, tt-logleser, tt-administrator, or "none".
ROLLEKATALOG_GLOBAL_ROLES=tt-administrator
# A sync that would disable or delete more than this percent of the mirrored users
# (or role assignments) aborts; only the admin button can force it.
ROLLEKATALOG_SYNC_MAX_REMOVAL_PERCENT=30
# Rollekatalog-sourced roles not refreshed for this many seconds stop applying
# (elevated access vanishes; the baseline tt-bruger stays). Default 86400 = 24 h.
ROLE_STALE_MAX_SECONDS=86400
# none (default) | strip-upn-domain: strip "@domain" from the login claim before it
# is matched against the Rollekatalog userId (UPN "abc123@kommune.dk" -> "abc123").
# Microsoft logins link in Rollekatalog mode only with a single-tenant
# MICROSOFT_TENANT_ID (not common/organizations/consumers) and a matching tid.
DIRECTORY_USERID_TRANSFORM=none

# ── Skabelon sharing ─────────────────────────────────────────────────────────
# Read at runtime: change and `docker compose up -d app`, no rebuild needed.
# code: self-contained copy/paste code (no server storage); on unless "false".
# link: server-stored token + import link (table is created automatically on
#       first use); opt-in, only on when "true".
SKABELON_SHARE_CODE=true
SKABELON_SHARE_LINK=false

# ── Audit log ────────────────────────────────────────────────────────────────
# Activity metadata only (who did what, when, to which id), never content. Read at
# runtime: change and restart, no rebuild. Details: docs/central-access/audit.md.
# "true": also print every event as one JSON line on stdout (for a log shipper).
AUDIT_STDOUT=false
# "false": store no IP address in the log (user agent and request id are kept).
AUDIT_STORE_IP=true
# Delete events older than this many days. Blank or invalid = 365 (the default).
# To keep the log forever, set it explicitly to 0, off, false, never or forever.
# Pruning only runs when something calls POST /api/internal/audit/prune (see below).
AUDIT_RETENTION_DAYS=
# Most client-reported (meeting.*) events stored per user per 24 h. Blank, 0 or
# invalid = 2000. Extra events are acknowledged but not stored.
AUDIT_CLIENT_EVENTS_DAILY_CAP=
# SIEM feed (GET /api/audit/feed). Hex sha256 of the service key; blank turns the
# feed off. Compute: printf '%s' 'YOUR-KEY' | openssl dgst -sha256 -r | cut -d' ' -f1
# The key itself goes to the SIEM in the X-Audit-Key header and is never stored here.
AUDIT_FEED_API_KEY_HASH=
# The feed only returns rows older than this many seconds (default 10).
AUDIT_FEED_DELAY_SECONDS=10
# Shared secret (header X-Cron-Secret) for POST /api/internal/audit/prune and
# POST /api/internal/rollekatalog/sync. Blank makes both routes answer 404.
# openssl rand -hex 24
INTERNAL_CRON_SECRET=
