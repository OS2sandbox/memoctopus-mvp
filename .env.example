DATABASE_URL=postgres://postgres:postgres@localhost:5432/referat
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Must match the public URL of the app — used by better-auth for OAuth callbacks.
# Changing this requires redeploying the server (not just the frontend).
BETTER_AUTH_URL=http://localhost:3004
# Comma-separated extra trusted origins (localhost:3004 is always included)
BETTER_AUTH_TRUSTED_ORIGINS=
OPENAI_API_KEY=
# Chat LLM backend for minutes / PII / chapters / clarifications:
#   - OPENAI_API_KEY set  → hosted OpenAI (gpt-4o)
#   - no key              → self-hosted vLLM (Qwen) at http://vllm-chat:8000/v1
# Override the endpoint/model explicitly for any OpenAI-compatible server:
#   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_MODEL=
AUDIO_STORAGE_PATH=./audio-storage

# ── Auth ─────────────────────────────────────────────────────────────────────
# All auth settings are read at runtime, so changing them needs only a restart
# (`docker compose up -d app`) — no image rebuild.
#
# Microsoft and OIDC enable themselves as soon as their credentials are filled
# in. The *_ENABLED flags below are kill switches, not opt-ins: leave them blank
# for the default, or set "false" to force a method off while keeping its
# credentials in place.
EMAIL_PASSWORD_ENABLED=true
MICROSOFT_ENABLED=
OIDC_ENABLED=

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Leave blank to allow any Microsoft account (personal + work/school)
MICROSOFT_TENANT_ID=

# Generic OIDC — Keycloak, Authentik, or any standards-compliant IdP.
# Setup, discovery URL patterns per IdP, the redirect URI to register, and the
# account-linking caveat: see DEPLOY.md → "Single sign-on (OIDC)".
#
# ⚠️  OIDC_PROVIDER_ID is part of the callback URL *and* the key that ties users
#     to their accounts. Changing it after go-live means returning users no longer
#     match their existing account and get a brand-new (empty) one. Pick it once.
# Leave both commented out to take the defaults ("oidc"/"SSO", or "authentik"/
# "Authentik" when upgrading from the AUTHENTIK_* variables below). Setting
# OIDC_PROVIDER_ID explicitly overrides that fallback.
#OIDC_PROVIDER_ID=keycloak
# Button label only: "Fortsæt med <name>".
#OIDC_PROVIDER_NAME=Kommune Login
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
# PKCE is on by default. Set "false" only if your IdP rejects the extra params.
OIDC_PKCE=

# Deprecated aliases, still read so existing deployments keep working:
#   NEXT_PUBLIC_EMAIL_PASSWORD_ENABLED → EMAIL_PASSWORD_ENABLED
#   NEXT_PUBLIC_MICROSOFT_ENABLED      → MICROSOFT_ENABLED
#   NEXT_PUBLIC_AUTHENTIK_ENABLED      → OIDC_ENABLED
#   AUTHENTIK_CLIENT_ID/_SECRET/_DISCOVERY_URL → the OIDC_* equivalents
# The AUTHENTIK_* trio applies only when OIDC_* is incomplete; migration steps
# are in DEPLOY.md.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_DISCOVERY_URL=

# ── Central access control ───────────────────────────────────────────────────
# Roles and org units. Read at runtime: change and restart, no rebuild.
# local:        an administrator assigns roles in the app (/admin).
# rollekatalog: roles come from OS2rollekatalog; the local admin writes answer 409.
ACCESS_SOURCE=local
# "true": a user with no role assignment gets "Ingen adgang" instead of the app
# pages (disabled users always do). Only the pages are gated; the older /api
# routes do not check roles yet. Default is false, so every signed-in user keeps
# the baseline role tt-bruger and nothing changes on upgrade.
REQUIRE_ROLE_TO_LOGIN=false
# Comma-separated, case-insensitive. Local mode only: grants tt-administrator to
# the first SSO login with one of these addresses while no administrator exists.
# Email/password sign-ups never qualify. Microsoft also needs a single-tenant
# MICROSOFT_TENANT_ID; generic OIDC needs email_verified=true from the IdP.
BOOTSTRAP_ADMIN_EMAILS=
# Rollekatalog mode only: how a login is linked to a directory user.
#   userid-claim (default) | extuuid-claim | email (needs email_verified=true)
DIRECTORY_MATCH=userid-claim
# ID-token claim that carries the Rollekatalog user id (userid-claim/extuuid-claim).
DIRECTORY_USERID_CLAIM=preferred_username
# Headers better-auth reads the client IP from, e.g. "x-real-ip,x-forwarded-for".
# Blank keeps better-auth's default (x-forwarded-for). Your reverse proxy must
# overwrite any client-supplied value.
AUTH_IP_HEADERS=

# ── Rollekatalog (OS2rollekatalog) ───────────────────────────────────────────
# Only used when ACCESS_SOURCE=rollekatalog (the connection test and the sync can
# also be tried before switching). Rollekatalog is READ-ONLY for this app: it never
# calls a write endpoint. Read at runtime: change and restart, no rebuild. Operator
# guide: docs/central-access/rollekatalog.md.
# Base URL of Rollekatalog. Must be https:// (plain http only for localhost, or when
# ROLLEKATALOG_ALLOW_HTTP=true). Blank = integration not configured.
ROLLEKATALOG_URL=
# API key of a Rollekatalog API client with client role READ_ACCESS (login check,
# role assignments). Never log or commit it.
ROLLEKATALOG_READ_API_KEY=
# API key of a SECOND API client with client role ORGANISATION (users, org units,
# managers). It does not imply READ_ACCESS, so both keys are needed for a sync.
ROLLEKATALOG_ORG_API_KEY=
# Identifier of the IT system the roles are registered under.
ROLLEKATALOG_ITSYSTEM_ID=os2taletiltekst
# Rollekatalog domain; blank = its primary domain.
ROLLEKATALOG_DOMAIN=
# Per request, in ms. The login-time check never waits longer than 3000 ms.
ROLLEKATALOG_TIMEOUT_MS=10000
# Largest accepted response in bytes. Blank = 67108864 (64 MiB).
ROLLEKATALOG_MAX_RESPONSE_BYTES=
# "true" allows a plain http:// URL on a non-local host (API keys then travel in
# cleartext). Leave blank unless the traffic is on a trusted private network.
ROLLEKATALOG_ALLOW_HTTP=
# How a role's org-unit scope is derived: constraint (default) | constraint-or-manager | manager
ROLLEKATALOG_SCOPE_STRATEGY=constraint
# "true" (default): a scope unit also covers its sub-units; "false": that unit only.
ROLLEKATALOG_SCOPE_DESCENDANTS=true
# Roles that may become organisation-wide when an assignment carries no usable
# org-unit scope. Default tt-administrator only; every other role is then NOT granted.
# Comma list of tt-bruger, tt-skabelonansvarlig, tt-logleser, tt-administrator, or "none".
ROLLEKATALOG_GLOBAL_ROLES=tt-administrator
# A sync that would disable or delete more than this percent of the mirrored users
# (or role assignments) aborts; only the admin button can force it.
ROLLEKATALOG_SYNC_MAX_REMOVAL_PERCENT=30
# Rollekatalog-sourced roles not refreshed for this many seconds stop applying
# (elevated access vanishes; the baseline tt-bruger stays). Default 86400 = 24 h.
ROLE_STALE_MAX_SECONDS=86400
# none (default) | strip-upn-domain: strip "@domain" from the login claim before it
# is matched against the Rollekatalog userId (UPN "abc123@kommune.dk" -> "abc123").
DIRECTORY_USERID_TRANSFORM=none
# Interval of the optional compose service "rollekatalog-sync" (profile rollekatalog;
# needs INTERNAL_CRON_SECRET below; start with: docker compose --profile rollekatalog up -d).
# Read by docker compose, not by the app; minimum 60, otherwise 900 is used.
ROLLEKATALOG_SYNC_INTERVAL_SECONDS=900

# Skabelon sharing methods — choose which ways users can share templates.
# code: a self-contained copy/paste code (no server storage); on unless set to "false".
# link: a server-stored token + import link (needs the shared_skabeloner table,
#       created automatically on first use); opt-in, set to "true" to enable.
SKABELON_SHARE_CODE=true
SKABELON_SHARE_LINK=false

# Microsoft Teams bot service
BOT_SERVICE_URL=http://localhost:3001
BOT_INTERNAL_SECRET=change-me-to-a-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3004
# URL the bot-service uses to call back into the Next.js app (dev runs on 3004)
NEXT_APP_URL=http://localhost:3004

# Transcription — STT, OpenAI-compatible API (per-utterance live path + batch pass).
# Selection mirrors the LLM backend above:
#   - HVISKE_API_KEY set  → hosted syv.ai platform (syv-transcribe) + inline diarization
#   - no key              → self-hosted vLLM ASR (syvai/hviske-ensemble) at http://vllm-asr:8000/v1
# Override the endpoint/model explicitly for any OpenAI-compatible STT server:
#   HVISKE_URL=https://platform.syv.ai/v1   HVISKE_MODEL=syv-transcribe
HVISKE_URL=
HVISKE_MODEL=
HVISKE_API_KEY=
ASR_LANGUAGE=da
# HVISKE_DIARIZE: inline diarization (one call returns text + speaker + timestamps).
# Auto-ON for platform.syv.ai, auto-OFF for the self-hosted hviske (which transcribes
# only and diarizes via the separate /diarize service below). Set true|false to override.
HVISKE_DIARIZE=true

# Speaker diarization — runs a single acoustic pass over the full recording to label
# "who spoke when"; the result is merged onto the hviske transcript by time-overlap.
# It is now co-hosted ON the hviske server at POST /diarize (same host:port as
# transcription). Leave DIARIZATION_URL empty to derive it from HVISKE_URL (minus the
# /v1 suffix); set it explicitly only for a split deployment (e.g. the standalone
# diarization-service/ container, which still serves /diarize too).
DIARIZATION_URL=
DIARIZATION_API_KEY=
# Optional: only for a SPLIT deployment where diarization runs on a separate box
# reachable over SSH. With the co-hosted endpoint above no tunnel is needed.
#   DIARIZATION_SSH=-p 22 user@gpu-host
#   DIARIZATION_TUNNEL=5000:localhost:5000
DIARIZATION_SSH=
DIARIZATION_TUNNEL=5000:localhost:5000

# ── Audit log ────────────────────────────────────────────────────────────────
# Activity metadata only (who did what, when, to which id), never content. Read at
# runtime: change and restart, no rebuild. Details: docs/central-access/audit.md.
# "true": also print every event as one JSON line on stdout (for a log shipper).
AUDIT_STDOUT=false
# "false": store no IP address in the log (user agent and request id are kept).
AUDIT_STORE_IP=true
# Delete events older than this many days. Blank (or invalid) keeps them forever.
# Pruning only runs when something calls POST /api/internal/audit/prune (see below).
AUDIT_RETENTION_DAYS=
# SIEM feed (GET /api/audit/feed). Hex sha256 of the service key; blank turns the
# feed off. Compute: printf '%s' 'YOUR-KEY' | openssl dgst -sha256 -r | cut -d' ' -f1
# The key itself goes to the SIEM in the X-Audit-Key header and is never stored here.
AUDIT_FEED_API_KEY_HASH=
# The feed only returns rows older than this many seconds (default 10).
AUDIT_FEED_DELAY_SECONDS=10
# Shared secret for POST /api/internal/audit/prune (header X-Cron-Secret). Blank
# makes that route answer 404. openssl rand -hex 24
INTERNAL_CRON_SECRET=
