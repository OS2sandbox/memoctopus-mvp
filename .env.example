DATABASE_URL=postgres://postgres:postgres@localhost:5432/referat
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Must match the public URL of the app — used by better-auth for OAuth callbacks.
# Changing this requires redeploying the server (not just the frontend).
BETTER_AUTH_URL=http://localhost:3004
# Comma-separated extra trusted origins (localhost:3004 is always included)
BETTER_AUTH_TRUSTED_ORIGINS=
OPENAI_API_KEY=
# Chat LLM backend for minutes / PII / chapters / clarifications:
#   - OPENAI_API_KEY set  → hosted OpenAI (gpt-4o)
#   - no key              → self-hosted vLLM (Qwen) at http://vllm-chat:8000/v1
# Override the endpoint/model explicitly for any OpenAI-compatible server:
#   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_MODEL=
# Prompt sizing. Minutes generation budgets the transcript against the context window
# of whatever LLM_MODEL actually is — it cannot detect it, so set it when pointing at a
# small self-hosted model or long meetings will be truncated mid-referat.
#   LLM_CONTEXT_TOKENS      model context window (default 65536, matching docker-compose.vllm.yml)
#   LLM_MAX_OUTPUT_TOKENS   cap on the referat itself (default 2000)
#   LLM_CHARS_PER_TOKEN     pessimistic chars-per-token for Danish (default 2.5)
#   LLM_PROMPT_RESERVE_TOKENS  room for system prompt + instructions (default 1000)
#   LLM_CHAPTER_SPLIT_CHARS    summarise per chapter above this size (default 20000)
#   LLM_CHAPTER_SUMMARY_MAX_TOKENS  cap per chapter summary (default 500)
LLM_CONTEXT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
AUDIO_STORAGE_PATH=./audio-storage

# ── Auth ─────────────────────────────────────────────────────────────────────
# All auth settings are read at runtime, so changing them needs only a restart
# (`docker compose up -d app`) — no image rebuild.
#
# Microsoft and OIDC enable themselves as soon as their credentials are filled
# in. The *_ENABLED flags below are kill switches, not opt-ins: leave them blank
# for the default, or set "false" to force a method off while keeping its
# credentials in place.
EMAIL_PASSWORD_ENABLED=true
MICROSOFT_ENABLED=
OIDC_ENABLED=

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Leave blank to allow any Microsoft account (personal + work/school)
MICROSOFT_TENANT_ID=

# Generic OIDC — Keycloak, Authentik, or any standards-compliant IdP.
# Setup, discovery URL patterns per IdP, the redirect URI to register, and the
# account-linking caveat: see DEPLOY.md → "Single sign-on (OIDC)".
#
# ⚠️  OIDC_PROVIDER_ID is part of the callback URL *and* the key that ties users
#     to their accounts. Changing it after go-live means returning users no longer
#     match their existing account and get a brand-new (empty) one. Pick it once.
# Leave both commented out to take the defaults ("oidc"/"SSO", or "authentik"/
# "Authentik" when upgrading from the AUTHENTIK_* variables below). Setting
# OIDC_PROVIDER_ID explicitly overrides that fallback.
#OIDC_PROVIDER_ID=keycloak
# Button label only: "Fortsæt med <name>".
#OIDC_PROVIDER_NAME=Kommune Login
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
# PKCE is on by default. Set "false" only if your IdP rejects the extra params.
OIDC_PKCE=

# Deprecated aliases, still read so existing deployments keep working:
#   NEXT_PUBLIC_EMAIL_PASSWORD_ENABLED → EMAIL_PASSWORD_ENABLED
#   NEXT_PUBLIC_MICROSOFT_ENABLED      → MICROSOFT_ENABLED
#   NEXT_PUBLIC_AUTHENTIK_ENABLED      → OIDC_ENABLED
#   AUTHENTIK_CLIENT_ID/_SECRET/_DISCOVERY_URL → the OIDC_* equivalents
# The AUTHENTIK_* trio applies only when OIDC_* is incomplete; migration steps
# are in DEPLOY.md.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_DISCOVERY_URL=

# Skabelon sharing methods — choose which ways users can share templates.
# code: a self-contained copy/paste code (no server storage); on unless set to "false".
# link: a server-stored token + import link (needs the shared_skabeloner table,
#       created automatically on first use); opt-in, set to "true" to enable.
SKABELON_SHARE_CODE=true
SKABELON_SHARE_LINK=false

# Microsoft Teams bot service
BOT_SERVICE_URL=http://localhost:3001
BOT_INTERNAL_SECRET=change-me-to-a-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3004
# URL the bot-service uses to call back into the Next.js app (dev runs on 3004)
NEXT_APP_URL=http://localhost:3004

# Transcription — STT, OpenAI-compatible API (per-utterance live path + batch pass).
# Selection mirrors the LLM backend above:
#   - HVISKE_API_KEY set  → hosted syv.ai platform (syv-transcribe) + inline diarization
#   - no key              → self-hosted vLLM ASR (syvai/hviske-ensemble) at http://vllm-asr:8000/v1
# Override the endpoint/model explicitly for any OpenAI-compatible STT server:
#   HVISKE_URL=https://platform.syv.ai/v1   HVISKE_MODEL=syv-transcribe
HVISKE_URL=
HVISKE_MODEL=
HVISKE_API_KEY=
ASR_LANGUAGE=da
# HVISKE_DIARIZE: inline diarization (one call returns text + speaker + timestamps).
# Auto-ON for platform.syv.ai, auto-OFF for the self-hosted hviske (which transcribes
# only and diarizes via the separate /diarize service below). Set true|false to override.
HVISKE_DIARIZE=true

# Speaker diarization — runs a single acoustic pass over the full recording to label
# "who spoke when"; the result is merged onto the hviske transcript by time-overlap.
# It is now co-hosted ON the hviske server at POST /diarize (same host:port as
# transcription). Leave DIARIZATION_URL empty to derive it from HVISKE_URL (minus the
# /v1 suffix); set it explicitly only for a split deployment (e.g. the standalone
# diarization-service/ container, which still serves /diarize too).
DIARIZATION_URL=
DIARIZATION_API_KEY=
# Optional: only for a SPLIT deployment where diarization runs on a separate box
# reachable over SSH. With the co-hosted endpoint above no tunnel is needed.
#   DIARIZATION_SSH=-p 22 user@gpu-host
#   DIARIZATION_TUNNEL=5000:localhost:5000
DIARIZATION_SSH=
DIARIZATION_TUNNEL=5000:localhost:5000
